# ---- LLM (pick one provider) ----
LLM_PROVIDER=anthropic            # anthropic | openai | groq
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional separate judge for RAGAS / LLM guardrails (recommended: different from generator)
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o-mini

# ---- Retrieval ----
VECTOR_STORE=faiss                # faiss | chroma
RETRIEVAL_STRATEGY=hybrid_rerank  # vector | hybrid | hybrid_rerank
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
CANDIDATE_K=20

# ---- Guardrails ----
GUARDRAILS_ENABLED=true
LLM_GUARDRAILS_ENABLED=false      # LLM-as-judge moderation + grounding check
MAX_INPUT_CHARS=2000

# ---- API ----
# API_KEY=change-me               # if set, requests need header X-API-Key
